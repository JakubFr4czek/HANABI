; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="hanabi"
config/description="HANABI (花火): VR Japanese dark-fantasy sword survivor."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/image="res://assets/splash/hanabi_boot.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"
GameEvents="*res://src/core/game_events.gd"
Sfx="*res://src/core/sfx.gd"
TimeController="*res://src/core/time_controller.gd"
VfxPool="*res://src/vfx/vfx_pool.gd"
RuntimeGuard="*res://src/debug/runtime_guard.gd"
VrComfortSettings="*res://src/core/vr_comfort_settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/hanabi_worldgen/plugin.cfg", "res://addons/hanabi_spawn/plugin.cfg")

[hanabi]

; The forest the run generates: one World Gen profile (docs/WORLDGEN_TOOL.md).
worldgen/profile="res://data/worldgen/default_profile.tres"

[layer_names]

3d_physics/layer_1="static_world"
3d_physics/layer_2="dynamic_props"
3d_physics/layer_3="player_weapon"
3d_physics/layer_4="enemy_body"
3d_physics/layer_5="enemy_weapon"
3d_physics/layer_6="weapon_rest"
3d_physics/layer_20="player_body"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_angular_velocity=150.0
common/physics_ticks_per_second=90
common/max_physics_steps_per_frame=12
common/physics_interpolation=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[shader_globals]

moon_direction={
"type": "vec3",
"value": Vector3(0.18, 0.407, -0.896)
}
storm_fog_color={
"type": "color",
"value": Color(0.16, 0.16, 0.27, 1)
}
storm_flash={
"type": "float",
"value": 0.0
}
storm_flash_dir={
"type": "vec2",
"value": Vector2(-0.25, -0.96)
}
intro_ripple_radius={
"type": "float",
"value": 0.0
}
intro_ripple_gain={
"type": "float",
"value": 0.0
}

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/foveation_level=3
openxr/foveation_dynamic=true
shaders/enabled=true
