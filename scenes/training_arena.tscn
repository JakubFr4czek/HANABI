transform = Transform3D(0.9397, 0, -0.342, 0, 1, 0, 0.342, 0, 0.9397, 2.3, 2.35, -4.3)
pixel_size = 0.0022
text = "DOJO OF THE STORM — CONTROLS
VR: left stick move, right stick turn
    hold GRIP on handle/tsuba/blade spine (1H or 2H)
    GRIP + B/Y: recall a weapon
    B/Y (no grip): dummy attacks on/off
    stick click: change element
    A/X: reset the dummy
Desktop: see the top-left of the window"
